{
  "name": "orez-sync-executor",
  "version": "0.16.21",
  "description": "Internal orez engine package. Do not import directly: consumers use limesync (e.g. limesync/realtime).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "import": "./dist/realtime/index.js"
    },
    "./sql-billing": {
      "types": "./dist/sql-billing.d.ts",
      "import": "./dist/sql-billing.js"
    },
    "./zero": {
      "types": "./dist/zero/zero/src/zero.d.ts",
      "default": "./dist/zero/zero/src/zero.js"
    },
    "./zero/bindings": {
      "types": "./dist/zero/zero/src/bindings.d.ts",
      "default": "./dist/zero/zero/src/bindings.js"
    },
    "./zero/react": {
      "types": "./dist/zero/zero/src/react.d.ts",
      "default": "./dist/zero/zero/src/react.js"
    },
    "./zero/server": {
      "types": "./dist/zero/zero/src/server.d.ts",
      "default": "./dist/zero/zero/src/server.js"
    },
    "./zero/op-sqlite": {
      "types": "./dist/zero/zero/src/op-sqlite.d.ts",
      "default": "./dist/zero/zero/src/op-sqlite.js"
    },
    "./zero/sqlite": {
      "types": "./dist/zero/zero/src/sqlite.d.ts",
      "default": "./dist/zero/zero/src/sqlite.js"
    },
    "./zero/sync-connection": {
      "types": "./dist/zero/zero-client/src/client/sync-connection.d.ts",
      "default": "./dist/zero/zero-client/src/client/sync-connection.js"
    },
    "./zero/http-transport": {
      "types": "./dist/zero/http/transport.d.ts",
      "default": "./dist/zero/http/transport.js"
    },
    "./zero/http-payload-codec": {
      "types": "./dist/zero/http/payload-codec.d.ts",
      "default": "./dist/zero/http/payload-codec.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist/zero && tsc -p zero/tsconfig.json && tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.7.0",
    "vitest": "3.2.7",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "files": [
    "dist",
    "zero/LICENSE",
    "zero/NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/sync-executor"
  },
  "dependencies": {
    "@badrap/valita": "0.3.11",
    "@rocicorp/lock": "^1.0.4",
    "@rocicorp/logger": "^6.1.0",
    "@rocicorp/resolver": "^1.0.2",
    "@standard-schema/spec": "^1.0.0",
    "compare-utf8": "^0.2.0",
    "js-xxhash": "^4.0.0"
  },
  "peerDependencies": {
    "@op-engineering/op-sqlite": ">=15",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@op-engineering/op-sqlite": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
