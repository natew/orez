{
  "name": "@o/env",
  "version": "0.16.14",
  "description": "Typed environment configuration for browser-safe application modules and local tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/env"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.28.0",
    "oxlint": "1.43.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
