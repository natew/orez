{
  "name": "@o/native-hot-update",
  "version": "0.16.19",
  "main": "dist/cjs",
  "module": "dist/esm",
  "devDependencies": {
    "@tamagui/build": "2.3.1",
    "@types/react": "^18.3.18",
    "react": "*",
    "react-native": "*",
    "react-native-mmkv": "^3.1.0",
    "typescript": "^5.7.3",
    "@hot-updater/react-native": "^0.25.8"
  },
  "peerDependencies": {
    "expo-application": "*",
    "react": "*",
    "react-native": "*",
    "@hot-updater/react-native": "^0.25.8",
    "react-native-mmkv": "^3.1.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-native": "./dist/esm/index.native.js",
      "types": "./src/index.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./mmkv": {
      "types": "./src/mmkv.ts",
      "import": "./dist/esm/mmkv.mjs",
      "require": "./dist/cjs/mmkv.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tamagui-build --skip-types",
    "watch": "tamagui-build --skip-types --watch",
    "clean": "tamagui-build clean",
    "typecheck": "tko run typecheck",
    "lint": "oxlint src",
    "check": "tsc --noEmit"
  },
  "sideEffects": false,
  "source": "src/index.ts",
  "type": "module",
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/native-hot-update"
  }
}
