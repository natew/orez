{
  "name": "orez-lite",
  "version": "0.16.7",
  "description": "SQLite and Rust sync engine for Zero applications",
  "type": "module",
  "sideEffects": [
    "./dist/cloudflare-bun-wasm-loader.js",
    "./dist/cloudflare-node-wasm-loader.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./wake": {
      "types": "./dist/wake.d.ts",
      "import": "./dist/wake.js",
      "default": "./dist/wake.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "default": "./dist/realtime.js"
    },
    "./encryption": {
      "types": "./dist/client/encrypted-column-codec.d.ts",
      "import": "./dist/client/encrypted-column-codec.js",
      "default": "./dist/client/encrypted-column-codec.js"
    },
    "./encryption/conformance": {
      "types": "./dist/client/encrypted-column-conformance.d.ts",
      "import": "./dist/client/encrypted-column-conformance.js",
      "default": "./dist/client/encrypted-column-conformance.js"
    },
    "./aggregate": {
      "types": "./dist/aggregate.d.ts",
      "import": "./dist/aggregate.js",
      "default": "./dist/aggregate.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "default": "./dist/local.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./cloudflare/build": {
      "types": "./dist/cloudflare-build.d.ts",
      "import": "./dist/cloudflare-build.js",
      "default": "./dist/cloudflare-build.js"
    },
    "./cloudflare/sync": {
      "types": "./dist/cloudflare-sync.d.ts",
      "import": "./dist/cloudflare-sync.js",
      "default": "./dist/cloudflare-sync.js"
    },
    "./cloudflare/query-compiler": {
      "types": "./dist/cloudflare-query-compiler.d.ts",
      "import": "./dist/cloudflare-query-compiler.js",
      "default": "./dist/cloudflare-query-compiler.js"
    },
    "./cloudflare/transaction-query": {
      "types": "./dist/cloudflare-transaction-query.d.ts",
      "import": "./dist/cloudflare-transaction-query.js",
      "default": "./dist/cloudflare-transaction-query.js"
    },
    "./cloudflare/vite-wasm-loader": {
      "types": "./dist/cloudflare-vite-wasm-loader.d.ts",
      "import": "./dist/cloudflare-vite-wasm-loader.js",
      "default": "./dist/cloudflare-vite-wasm-loader.js"
    },
    "./cloudflare/node-wasm-loader": {
      "types": "./dist/cloudflare-node-wasm-loader.d.ts",
      "import": "./dist/cloudflare-node-wasm-loader.js",
      "default": "./dist/cloudflare-node-wasm-loader.js"
    },
    "./cloudflare/bun-wasm-loader": {
      "types": "./dist/cloudflare-bun-wasm-loader.d.ts",
      "import": "./dist/cloudflare-bun-wasm-loader.js",
      "default": "./dist/cloudflare-bun-wasm-loader.js"
    }
  },
  "bin": {
    "orez-lite": "dist/cli.js"
  },
  "scripts": {
    "build:runtime": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "build:dependencies": "bun run --cwd ../sync-cf-host build:dist",
    "build": "bun run build:dependencies && bun run build:runtime && bun run --cwd ../sync-browser-host build:runtime",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/orez-lite/src",
    "test:application-push-workerd": "bun application-push-workerd-test.mjs",
    "test:migration-workerd": "bun migration-workerd-test.mjs",
    "test:package": "bun run build && node package-runtime-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "bedrock-sqlite": "workspace:*",
    "esbuild": "^0.25.0",
    "orez-sync-cf-host": "workspace:*",
    "orez-sync-executor": "workspace:*"
  },
  "peerDependencies": {
    "@rocicorp/zero": ">=1.7.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "orez-sync-native": "workspace:*"
  },
  "devDependencies": {
    "@rocicorp/zero": "1.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.75.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/orez-lite"
  },
  "keywords": [
    "zero",
    "sqlite",
    "rust",
    "cloudflare"
  ],
  "license": "MIT"
}
