{
  "name": "@o/cli",
  "version": "0.16.19",
  "description": "Typed command and subprocess helpers for Orez consumers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "o": "./dist/cli.js",
    "tko": "./src/tko/cli.ts",
    "takeout": "./src/tko/cli.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils/*": {
      "types": "./src/tko/utils/*.ts",
      "default": "./src/tko/utils/*.ts"
    },
    "./constants/*": {
      "types": "./src/tko/constants/*.ts",
      "default": "./src/tko/constants/*.ts"
    },
    "./withOpSqliteStatic": "./src/tko/withOpSqliteStatic.cjs",
    "./withExpoModulesCoreSwift6Fix": "./src/tko/withExpoModulesCoreSwift6Fix.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "src/tko"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/run-pty.mjs dist/run-pty.mjs && chmod +x dist/cli.js dist/run-pty.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "picocolors": "^1.1.1",
    "@o/run": "workspace:*",
    "@o/scripts": "workspace:*",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.28.0",
    "oxlint": "1.43.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  }
}
