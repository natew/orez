{
  "name": "limesync",
  "version": "0.16.21",
  "description": "SQLite and Rust sync engine for Zero applications",
  "type": "module",
  "sideEffects": [
    "./dist/cloudflare-bun-wasm-loader.js",
    "./dist/cloudflare-node-wasm-loader.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./wake": {
      "types": "./dist/wake.d.ts",
      "import": "./dist/wake.js",
      "default": "./dist/wake.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "default": "./dist/realtime.js"
    },
    "./room": {
      "types": "./dist/room/index.d.ts",
      "import": "./dist/room/index.js",
      "default": "./dist/room/index.js"
    },
    "./room/host": {
      "types": "./dist/room/host.d.ts",
      "import": "./dist/room/host.js",
      "default": "./dist/room/host.js"
    },
    "./room/cloudflare": {
      "types": "./dist/room/cloudflare.d.ts",
      "import": "./dist/room/cloudflare.js",
      "default": "./dist/room/cloudflare.js"
    },
    "./room/ticket": {
      "types": "./dist/room/ticket.d.ts",
      "import": "./dist/room/ticket.js",
      "default": "./dist/room/ticket.js"
    },
    "./encryption": {
      "types": "./dist/client/encrypted-column-codec.d.ts",
      "import": "./dist/client/encrypted-column-codec.js",
      "default": "./dist/client/encrypted-column-codec.js"
    },
    "./encryption/conformance": {
      "types": "./dist/client/encrypted-column-conformance.d.ts",
      "import": "./dist/client/encrypted-column-conformance.js",
      "default": "./dist/client/encrypted-column-conformance.js"
    },
    "./aggregate": {
      "types": "./dist/aggregate.d.ts",
      "import": "./dist/aggregate.js",
      "default": "./dist/aggregate.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "default": "./dist/local.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./cloudflare/build": {
      "types": "./dist/cloudflare-build.d.ts",
      "import": "./dist/cloudflare-build.js",
      "default": "./dist/cloudflare-build.js"
    },
    "./cloudflare/sync": {
      "types": "./dist/cloudflare-sync.d.ts",
      "import": "./dist/cloudflare-sync.js",
      "default": "./dist/cloudflare-sync.js"
    },
    "./cloudflare/query-compiler": {
      "types": "./dist/cloudflare-query-compiler.d.ts",
      "import": "./dist/cloudflare-query-compiler.js",
      "default": "./dist/cloudflare-query-compiler.js"
    },
    "./cloudflare/transaction-query": {
      "types": "./dist/cloudflare-transaction-query.d.ts",
      "import": "./dist/cloudflare-transaction-query.js",
      "default": "./dist/cloudflare-transaction-query.js"
    },
    "./cloudflare/vite-wasm-loader": {
      "types": "./dist/cloudflare-vite-wasm-loader.d.ts",
      "import": "./dist/cloudflare-vite-wasm-loader.js",
      "default": "./dist/cloudflare-vite-wasm-loader.js"
    },
    "./cloudflare/node-wasm-loader": {
      "types": "./dist/cloudflare-node-wasm-loader.d.ts",
      "import": "./dist/cloudflare-node-wasm-loader.js",
      "default": "./dist/cloudflare-node-wasm-loader.js"
    },
    "./cloudflare/bun-wasm-loader": {
      "types": "./dist/cloudflare-bun-wasm-loader.d.ts",
      "import": "./dist/cloudflare-bun-wasm-loader.js",
      "default": "./dist/cloudflare-bun-wasm-loader.js"
    },
    "./zero": {
      "types": "./dist/zero/zero.d.ts",
      "import": "./dist/zero/zero.js",
      "default": "./dist/zero/zero.js"
    },
    "./zero/bindings": {
      "types": "./dist/zero/bindings.d.ts",
      "import": "./dist/zero/bindings.js",
      "default": "./dist/zero/bindings.js"
    },
    "./zero/react": {
      "types": "./dist/zero/react.d.ts",
      "import": "./dist/zero/react.js",
      "default": "./dist/zero/react.js"
    },
    "./zero/server": {
      "types": "./dist/zero/server.d.ts",
      "import": "./dist/zero/server.js",
      "default": "./dist/zero/server.js"
    },
    "./zero/op-sqlite": {
      "types": "./dist/zero/op-sqlite.d.ts",
      "import": "./dist/zero/op-sqlite.js",
      "default": "./dist/zero/op-sqlite.js"
    },
    "./zero/sqlite": {
      "types": "./dist/zero/sqlite.d.ts",
      "import": "./dist/zero/sqlite.js",
      "default": "./dist/zero/sqlite.js"
    },
    "./data/snapshot": {
      "types": "./dist/data/snapshot.d.ts",
      "react-native": "./dist/data/snapshot.native.js",
      "default": "./dist/data/snapshot.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "react-native": "./dist/data/index.native.js",
      "default": "./dist/data/index.js"
    },
    "./data/server": {
      "types": "./dist/data/server.d.ts",
      "default": "./dist/data/server.js"
    },
    "./data/multi": {
      "types": "./dist/data/multi.d.ts",
      "react-native": "./dist/data/multi.native.js",
      "default": "./dist/data/multi.js"
    },
    "./data/streaming": {
      "types": "./dist/data/streaming.d.ts",
      "default": "./dist/data/streaming.js"
    },
    "./data/kv-store": {
      "types": "./dist/data/kvStore.d.ts",
      "react-native": "./dist/data/kvStore.native.js",
      "default": "./dist/data/kvStore.js"
    },
    "./data/generate": {
      "types": "./dist/data/generate.d.ts",
      "default": "./dist/data/generate.js"
    },
    "./data/generate-lite": {
      "types": "./dist/data/generate-lite.d.ts",
      "default": "./dist/data/generate-lite.js"
    },
    "./data/bun": {
      "types": "./dist/data/bun-plugin.d.ts",
      "default": "./dist/data/bun-plugin.js"
    },
    "./data/virtual": {
      "types": "./virtual-app.d.ts"
    },
    "./data/vite": {
      "types": "./dist/data/vite-plugin.d.ts",
      "default": "./dist/data/vite-plugin.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "default": "./dist/better-auth.js"
    }
  },
  "bin": {
    "limesync": "dist/cli.js"
  },
  "scripts": {
    "build:runtime": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/native-graph.mjs && chmod +x dist/cli.js",
    "build:dependencies": "bun run --cwd ../sync-cf-host build:dist",
    "build": "bun run build:dependencies && bun run build:runtime && bun run --cwd ../sync-browser-host build:runtime",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/limesync/src",
    "test:rollback-workerd": "node rollback-workerd-test.mjs",
    "test:application-push-workerd": "bun application-push-workerd-test.mjs",
    "test:migration-workerd": "bun migration-workerd-test.mjs",
    "test:write-attribution-workerd": "bun write-attribution-workerd-test.mjs",
    "test:package": "bun run build && node package-runtime-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:data": "vitest run --config vitest.data.config.ts && tsc -p data-type-fixtures/tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "7.29.7",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@rocicorp/logger": "6.2.0",
    "bedrock-sqlite": "workspace:*",
    "chokidar": "^4.0.3",
    "citty": "^0.1.6",
    "dequal": "^2.0.3",
    "es-module-lexer": "1.7.0",
    "esbuild": "^0.25.0",
    "orez-sync-cf-host": "workspace:*",
    "orez-sync-executor": "workspace:*",
    "typescript": "7.0.2",
    "valibot": "^1.1.0",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "vite": ">=5",
    "react": "*",
    "better-auth": ">=1.6.0 <2"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "orez-sync-native": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.75.0",
    "@types/ws": "^8.18.1",
    "@types/react": "^19.0.0",
    "jsdom": "29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "better-auth": "1.6.30"
  },
  "files": [
    "dist",
    "virtual-app.d.ts",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/limesync"
  },
  "keywords": [
    "zero",
    "sqlite",
    "rust",
    "cloudflare"
  ],
  "license": "MIT"
}
