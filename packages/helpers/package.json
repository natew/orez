{
  "name": "@o/helpers",
  "version": "0.16.19",
  "description": "Small browser, React, storage, string, and timing helpers used by Orez consumers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/helpers"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "import": "./dist/server-only.js",
      "default": "./dist/server-only.js"
    },
    "./client-only": {
      "types": "./dist/client-only.d.ts",
      "import": "./dist/client-only.js",
      "default": "./dist/client-only.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/native-graph.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "expo-clipboard": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "expo-clipboard": "~57.0.1",
    "jsdom": "29.1.1",
    "oxfmt": "0.28.0",
    "oxlint": "1.43.0",
    "react": "^19.0.0",
    "react-dom": "19.2.7",
    "react-native": "*",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
