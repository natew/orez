{
  "name": "@o/database",
  "version": "0.16.19",
  "description": "SQLite database helpers for Orez hosts: Drizzle over a host-owned transaction, a Better Auth adapter with read and write lanes, seed application, and private-table marking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natew/orez.git",
    "directory": "packages/database"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "import": "./dist/better-auth.js",
      "default": "./dist/better-auth.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js",
      "default": "./dist/seed.js"
    },
    "./postgres": {
      "types": "./dist/takeout/index.d.ts",
      "import": "./dist/takeout/index.js",
      "default": "./dist/takeout/index.js"
    },
    "./postgres/*": {
      "types": "./dist/takeout/*.d.ts",
      "import": "./dist/takeout/*.js",
      "default": "./dist/takeout/*.js"
    },
    "./scripts/*": {
      "types": "./dist/takeout/scripts/*.d.ts",
      "import": "./dist/takeout/scripts/*.js",
      "default": "./dist/takeout/scripts/*.js"
    },
    "./postgres/helpers": {
      "types": "./dist/takeout/index.d.ts",
      "import": "./dist/takeout/index.js",
      "default": "./dist/takeout/index.js"
    },
    "./*": {
      "types": "./dist/takeout/*.d.ts",
      "import": "./dist/takeout/*.js",
      "default": "./dist/takeout/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "src/takeout"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0 <2",
    "drizzle-orm": ">=1.0.0-beta.0 <2",
    "pg": "^8.16.3",
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "better-auth": "1.6.30",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "oxfmt": "0.28.0",
    "oxlint": "1.43.0",
    "typescript": "5.9.3",
    "@types/pg": "^8.11.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@o/helpers": "workspace:*",
    "@types/async-retry": "1.4.9",
    "async-retry": "^1.3.3",
    "citty": "^0.1.6",
    "@aws-sdk/client-s3": "^3.709.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "bin": {
    "database": "./dist/takeout/cli.js"
  }
}
