{
  "name": "orez-sites",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_SITE=orez one dev",
    "dev:lime-sync": "VITE_SITE=lime-sync one dev",
    "build": "rm -rf dist && bun run build:orez && bun run build:lime-sync",
    "build:orez": "VITE_SITE=orez one build",
    "build:lime-sync": "VITE_SITE=lime-sync one build",
    "serve": "bun run serve:orez",
    "serve:orez": "VITE_SITE=orez one serve --outDir=dist/orez",
    "serve:lime-sync": "VITE_SITE=lime-sync one serve --outDir=dist/lime-sync",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tamagui/config": "2.3.1",
    "@vxrn/color-scheme": "1.20.4",
    "@vxrn/mdx-rust": "^1.20.4",
    "one": "^1.20.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-web": "^0.21.2",
    "tamagui": "2.3.1"
  },
  "devDependencies": {
    "@bruits/satteri-wasm32-wasi": "0.9.5",
    "@types/react": "^19.2.2",
    "vite": "^8.0.13"
  }
}
